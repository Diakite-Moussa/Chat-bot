# ==========================================
# Configuration de l'environnement - TP Chatbot
# ==========================================

# Fournisseur de LLM : "openai", "groq", ou "mock" (mode simulation intelligent si pas de clé)
LLM_PROVIDER=openai

# Clé API OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-votre-cle-api-openai-ici

# Modèle utilisé (ex: gpt-4o-mini, gpt-3.5-turbo, llama-3.1-70b-versatile, etc.)
OPENAI_MODEL=gpt-4o-mini

# Configuration Groq optionnelle (si LLM_PROVIDER=groq)
GROQ_API_KEY=gsk-votre-cle-api-groq-ici
GROQ_MODEL=llama-3.1-8b-instant

# Configuration du serveur Backend FastAPI
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
